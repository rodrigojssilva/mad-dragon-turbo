{{!-- Ancestral .mad-dragon-turbo + filho .mdt-top-card — o CSS da ficha usa descendente, não o mesmo elemento --}}
<div class="mad-dragon-turbo mdt-style-info-dialog-root">
    <div class="sheet-section mdt-top-card mdt-style-info-dialog-card">
        <p class="mdt-style-info-flavor">{{description}}</p>
        <div class="mdt-style-info-special-wrap">
            <p class="mdt-style-info-special">{{stats}}</p>
            {{#if extras.length}}
            <ul class="mdt-style-info-extras">
                {{#each extras}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
    </div>
</div>