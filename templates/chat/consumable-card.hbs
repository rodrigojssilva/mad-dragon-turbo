<div class="mdt-chat-card mdt-item-card mdt-consumable-card">
  <header class="mdt-chat-card-header">
    <span class="item-kind-badge" title="{{kindLabel}}">
      <i class="fas {{kindIcon}}" aria-hidden="true"></i>
    </span>
    <div class="mdt-chat-card-heading">
      <h3 class="item-card-name">{{actorName}}</h3>
      {{#if styleLabel}}
        <p class="item-card-style">{{styleLabel}}</p>
      {{/if}}
    </div>
  </header>

  <h4 class="item-card-consumed">{{localize "MDT.consumable.consumed"}}: <strong>{{item.name}}</strong></h4>

  {{#if spentAmount}}
    <p class="item-card-stock">{{localize "MDT.consumable.moneySpent"}}: <strong>{{spentAmount}}</strong></p>
  {{/if}}

  {{#if freeUse}}
    <p class="item-card-stock mdt-spell-uses-private">{{localize "MDT.spell.freeUseEnabled"}}</p>
  {{/if}}

  {{#if system.description}}
    <hr class="mdt-card-sep" />
    <div class="item-card-desc">
      {{{system.description}}}
    </div>
  {{/if}}
</div>
