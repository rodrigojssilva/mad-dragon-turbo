<div class="mdt-chat-card mdt-item-card mdt-equipment-card">
  <header class="mdt-chat-card-header">
    <span class="item-kind-badge" title="{{kindLabel}}">
      <i class="fas {{kindIcon}}" aria-hidden="true"></i>
    </span>
    <div class="mdt-chat-card-heading">
      <h3 class="item-card-name">{{actorName}}</h3>
      {{#if styleLabel}}
        <p class="item-card-style">{{styleLabel}}</p>
      {{/if}}
    </div>
  </header>

  <h4 class="item-card-consumed">{{localize "MDT.equipment.used"}}: <strong>{{item.name}}</strong></h4>

  <p class="item-card-target">{{localize "MDT.roll.target"}}: <strong>{{targetName}}</strong></p>
  <p class="item-card-target item-card-damage">{{localize "MDT.equipment.damage"}}: <strong>{{damage}}</strong></p>

  {{#if freeUse}}
    <p class="item-card-stock">{{localize "MDT.spell.freeUseEnabled"}}</p>
  {{else if trackAmmo}}
    <p class="item-card-stock mdt-spell-uses-private">{{localize "MDT.equipment.ammoRemaining"}}: <strong>{{ammo}}</strong></p>
  {{else}}
    <p class="item-card-stock">{{localize "MDT.equipment.quantityRemaining"}}: <strong>{{quantity}}</strong></p>
  {{/if}}

  {{#if system.description}}
    <hr class="mdt-card-sep" />
    <div class="item-card-desc">
      {{{system.description}}}
    </div>
  {{/if}}
</div>
