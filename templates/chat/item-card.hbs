<div class="mdt-chat-card mdt-item-card">
  <header class="mdt-chat-card-header{{#if hasCustomImg}} has-kind-mark{{else if showKindMark}} has-kind-mark{{else if showImageFallback}} has-kind-mark{{/if}}">
    {{#if hasCustomImg}}
    <span class="item-kind-badge" title="{{kindLabel}}">
      <img class="item-kind-img" src="{{img}}" alt="" />
    </span>
    {{else if showKindMark}}
    <span class="item-kind-badge" title="{{kindLabel}}">
      <i class="fas {{kindIcon}}" aria-hidden="true"></i>
    </span>
    {{else if showImageFallback}}
    <span class="item-kind-badge" title="{{kindLabel}}">
      <i class="fas fa-image" aria-hidden="true"></i>
    </span>
    {{/if}}
    <h3 class="item-card-name">{{item.name}}</h3>
  </header>
  {{#if system.description}}
    <div class="item-card-desc">{{system.description}}</div>
  {{/if}}
  {{#if isSpell}}
    <div class="item-card-meta">
      <span class="mdt-pill item-card-level">
        {{localize "MDT.spell.levelLabel"}}:
        {{#if isHighLevel}}
          {{localize "MDT.spell.levelHigh"}}
        {{else}}
          {{localize "MDT.spell.levelLow"}}
        {{/if}}
      </span>
      {{#if freeUse}}
        <span class="mdt-pill item-card-free-use">{{localize "MDT.spell.freeUseCheckbox"}}</span>
      {{else}}
        <span class="mdt-pill item-card-uses mdt-spell-uses-private">
          {{localize "MDT.spell.usesLabel"}}: {{remainingUses}} / {{maxUses}}
        </span>
        {{#if (eq remainingUses 0)}}
          <span class="mdt-pill item-card-empty-uses mdt-spell-uses-private">{{localize "MDT.spell.emptyUsesShort"}}</span>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}
</div>