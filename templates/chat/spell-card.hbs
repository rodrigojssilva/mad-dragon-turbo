<div class="mdt-chat-card mdt-item-card mdt-spell-card">
  <header class="mdt-chat-card-header">
    <h3 class="item-card-name">{{actorName}}</h3>
    {{#if styleLabel}}
      <p class="item-card-style">{{styleLabel}}</p>
    {{/if}}
  </header>

  <h4 class="item-card-spell-name">{{localize "MDT.spell.labelPrefix"}}: <strong>{{item.name}}</strong></h4>
  <hr class="mdt-card-sep" />

  {{#if targetName}}
    <p class="item-card-target">{{localize "MDT.roll.target"}}: <strong>{{targetName}}</strong></p>
    <hr class="mdt-card-sep" />
  {{/if}}

  {{#if system.description}}
    <div class="item-card-desc">
      {{{system.description}}}
    </div>
    {{#if isCast}}
      <hr class="mdt-card-sep" />
    {{else if showTags}}
      <hr class="mdt-card-sep" />
    {{/if}}
  {{/if}}

  {{#if isCast}}
    <div class="item-card-meta">
      <span class="mdt-pill item-card-level">
        {{localize "MDT.spell.levelLabel"}}:
        {{#if isHighLevel}}
          {{localize "MDT.spell.levelHigh"}}
        {{else}}
          {{localize "MDT.spell.levelLow"}}
        {{/if}}
      </span>
      {{#if freeUse}}
        <span class="mdt-pill item-card-free-use">{{localize "MDT.spell.freeUseCheckbox"}}</span>
      {{else}}
        <span class="mdt-pill item-card-uses mdt-spell-uses-private">
          {{localize "MDT.spell.usesLabel"}}: {{remainingUses}} / {{maxUses}}
        </span>
        {{#if (eq remainingUses 0)}}
          <span class="mdt-pill item-card-empty-uses mdt-spell-uses-private">{{localize "MDT.spell.emptyUsesShort"}}</span>
        {{/if}}
      {{/if}}
    </div>
  {{else if showTags}}
    <div class="item-card-meta">
      {{#if isHighLevel}}
        <span class="mdt-pill item-card-level">{{localize "MDT.spell.highLevelCheckbox"}}</span>
      {{/if}}
      {{#if freeUse}}
        <span class="mdt-pill item-card-free-use">{{localize "MDT.spell.freeUseCheckbox"}}</span>
      {{/if}}
    </div>
  {{/if}}
</div>
