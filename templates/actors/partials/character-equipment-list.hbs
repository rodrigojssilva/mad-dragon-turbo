{{!-- EQUIPAMENTOS --}}
<div class="sheet-section mdt-top-card mdt-list-card">
    <div class="section-header">
        <h3>{{localize "MDT.equipments"}}</h3>
        <a class="add-equipment"><i class="fas fa-plus"></i></a>
    </div>
    <ul class="items-list">
        {{#each equipment}}
        <li class="item-row item-row-equipment {{#if this.noUses}}equipment-no-uses{{/if}}" data-item-id="{{this.id}}">
            <div class="item-summary">
                <span class="item-name item-toggle">
                    <i class="fas fa-chevron-right item-chevron"></i>
                    <span class="item-kind-badge" title="{{this.kindLabel}}">
                        <i class="fas {{this.kindIcon}}" aria-hidden="true"></i>
                    </span>
                    {{this.name}} (x{{this.system.quantity}})
                    {{#if this.showAmmo}}
                    <span class="equipment-ammo-badge">| {{localize "MDT.equipment.ammoShort"}} {{this.system.ammo}} |</span>
                    {{/if}}
                    {{#if this.noUses}}
                    <span class="spell-empty-badge">{{localize "MDT.equipment.emptyUsesShort"}}</span>
                    {{/if}}
                </span>
                <div class="item-controls">
                    <a class="equipment-use" data-item-id="{{this.id}}"
                        data-no-uses="{{#if this.canUse}}false{{else}}true{{/if}}"
                        title="{{localize 'MDT.equipment.use'}}">
                        <i class="fas fa-gavel"></i>
                    </a>
                    <a class="item-to-chat" data-item-id="{{this.id}}" title="{{localize 'MDT.item.toChat'}}">
                        <i class="fas fa-comment"></i>
                    </a>
                    <a class="item-delete" title="{{localize 'MDT.item.delete'}}">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </div>

            <div class="item-description hidden">
                <label>
                    {{localize "MDT.equipment.kindLabel"}}
                    <select class="item-kind-input" disabled {{#if this.requiresKind}}required{{/if}}>
                        <option value="" {{#unless this.system.kind}}selected{{/unless}}>{{localize "MDT.equipment.kindPlaceholder"}}</option>
                        <option value="armor" {{#if (eq this.system.kind "armor")}}selected{{/if}}>{{localize "MDT.equipment.kinds.armor"}}</option>
                        <option value="shield" {{#if (eq this.system.kind "shield")}}selected{{/if}}>{{localize "MDT.equipment.kinds.shield"}}</option>
                        <option value="accessory" {{#if (eq this.system.kind "accessory")}}selected{{/if}}>{{localize "MDT.equipment.kinds.accessory"}}</option>
                        <option value="melee" {{#if (eq this.system.kind "melee")}}selected{{/if}}>{{localize "MDT.equipment.kinds.melee"}}</option>
                        <option value="firearm" {{#if (eq this.system.kind "firearm")}}selected{{/if}}>{{localize "MDT.equipment.kinds.firearm"}}</option>
                    </select>
                </label>
                <label>
                    {{localize "MDT.item.nameLabel"}}
                    <input class="item-name-input" type="text" disabled value="{{this.name}}"
                        placeholder="{{localize 'MDT.item.namePlaceholder'}}" />
                </label>
                <label>
                    {{localize "MDT.item.descLabel"}}
                    <textarea class="item-desc-input" disabled placeholder="{{localize 'MDT.item.descPlaceholder'}}"
                        rows="3">{{this.system.description}}</textarea>
                </label>

                <div class="equipment-fields">
                    <div class="equipment-inline-fields">
                        <label class="spell-checkbox">
                            <input class="equipment-free-use-input" type="checkbox" disabled {{#if this.system.freeUse}}checked{{/if}} />
                            {{localize "MDT.spell.freeUseCheckbox"}}
                        </label>
                        <label class="equipment-inline-qty">
                            <span class="equipment-inline-qty-label">{{localize "MDT.equipment.quantityLabel"}}</span>
                            <input class="equipment-qty-input" type="number" min="0" disabled value="{{this.system.quantity}}" />
                        </label>
                        <label class="spell-checkbox equipment-track-ammo-label">
                            <input class="equipment-track-ammo-input" type="checkbox" disabled {{#if this.system.trackAmmo}}checked{{/if}} />
                            {{localize "MDT.equipment.trackAmmo"}}
                        </label>
                        <label class="equipment-inline-qty">
                            <span class="equipment-inline-qty-label">{{localize "MDT.equipment.ammoLabel"}}</span>
                            <input class="equipment-ammo-input" type="number" min="0" disabled value="{{this.system.ammo}}" />
                        </label>
                    </div>
                    {{#if this.freeUseActive}}
                    <p class="spell-free-use-note">{{localize "MDT.spell.freeUseEnabled"}}</p>
                    {{else if this.noAmmo}}
                    <p class="spell-empty-note">{{localize "MDT.equipment.noAmmo"}}</p>
                    {{else if this.noQuantity}}
                    <p class="spell-empty-note">{{localize "MDT.equipment.noUses"}}</p>
                    {{/if}}
                </div>

                <div class="item-edit-toolbar">
                    <button type="button" class="item-edit-btn item-edit-start" title="Editar" aria-label="Editar">
                        <i class="fas fa-pen"></i>
                    </button>
                    <button type="button" class="item-edit-btn item-edit-cancel hidden" title="Cancelar" aria-label="Cancelar">
                        <i class="fas fa-times"></i>
                    </button>
                    <button type="button" class="item-edit-btn item-edit-save hidden" title="Salvar" aria-label="Salvar">
                        <i class="fas fa-floppy-disk"></i>
                    </button>
                </div>
            </div>
        </li>
        {{else}}
        <span>{{localize "MDT.equipment.empty"}}</span>
        {{/each}}
    </ul>
</div>
