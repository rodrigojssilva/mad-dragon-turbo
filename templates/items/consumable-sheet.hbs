<form class="sheet-form flexcol" autocomplete="off">
    <header class="sheet-header item-sheet-header">
        <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
        <div class="header-fields flexcol">
            <label class="item-sheet-label flexcol">
                {{localize "MDT.consumable.kindLabel"}}
                <select class="item-kind-input" name="system.kind" {{#if requiresKind}}required{{/if}}
                    {{#unless editable}}disabled{{else}}{{#unless itemEditing}}disabled{{/unless}}{{/unless}}>
                    <option value="" {{#unless system.kind}}selected{{/unless}}>{{localize "MDT.consumable.kindPlaceholder"}}</option>
                    <option value="key" {{#if (eq system.kind "key")}}selected{{/if}}>{{localize "MDT.consumable.kinds.key"}}</option>
                    <option value="potion" {{#if (eq system.kind "potion")}}selected{{/if}}>{{localize "MDT.consumable.kinds.potion"}}</option>
                    <option value="money" {{#if (eq system.kind "money")}}selected{{/if}}>{{localize "MDT.consumable.kinds.money"}}</option>
                    <option value="misc" {{#if (eq system.kind "misc")}}selected{{/if}}>{{localize "MDT.consumable.kinds.misc"}}</option>
                </select>
            </label>
            <label class="item-sheet-label flexcol">
                {{localize "MDT.item.nameLabel"}}
                <span class="item-name-with-kind">
                    <span class="item-kind-badge" title="{{kindLabel}}">
                        <i class="fas {{kindIcon}}" aria-hidden="true"></i>
                    </span>
                    <input class="item-name-input" name="name" type="text" value="{{item.name}}"
                        placeholder="{{localize 'MDT.item.namePlaceholder'}}"
                        {{#unless editable}}disabled{{else}}{{#unless itemEditing}}disabled{{/unless}}{{/unless}} />
                </span>
            </label>
            <div class="item-sheet-pill-row">
                <div class="item-type-pill">{{localize "TYPES.Item.consumable"}}</div>
                {{#if editable}}
                <div class="item-sheet-header-actions item-edit-toolbar">
                    {{#if itemEditing}}
                    <button type="button" class="item-edit-btn item-edit-cancel" title="{{localize 'MDT.item.cancel'}}"
                        aria-label="{{localize 'MDT.item.cancel'}}">
                        <i class="fas fa-times"></i>
                    </button>
                    <button type="button" class="item-edit-btn item-edit-save" title="{{localize 'MDT.item.save'}}"
                        aria-label="{{localize 'MDT.item.save'}}">
                        <i class="fas fa-floppy-disk"></i>
                    </button>
                    {{else}}
                    <button type="button" class="item-edit-btn item-edit-start" title="{{localize 'MDT.item.edit'}}"
                        aria-label="{{localize 'MDT.item.edit'}}">
                        <i class="fas fa-pen"></i>
                    </button>
                    {{/if}}
                </div>
                {{/if}}
            </div>
        </div>
    </header>

    <section class="sheet-body item-sheet-body">
        <div class="sheet-section mdt-top-card">
            <label class="item-sheet-label flexcol">
                {{localize "MDT.item.descLabel"}}
                <textarea class="item-desc-input" name="system.description" rows="6"
                    placeholder="{{localize 'MDT.item.descPlaceholder'}}"
                    {{#unless editable}}disabled{{else}}{{#unless itemEditing}}disabled{{/unless}}{{/unless}}>{{{system.description}}}</textarea>
            </label>

            <div class="equipment-fields">
                <div class="equipment-inline-fields">
                    <label class="spell-checkbox">
                        <input class="consumable-free-use-input" name="system.freeUse" type="checkbox" {{#if system.freeUse}}checked{{/if}}
                            {{#unless editable}}disabled{{else}}{{#unless itemEditing}}disabled{{/unless}}{{/unless}} />
                        {{localize "MDT.spell.freeUseCheckbox"}}
                    </label>
                    <label class="item-sheet-label equipment-inline-qty">
                        <span class="equipment-inline-qty-label">{{localize "MDT.consumable.quantityLabel"}}</span>
                        <input class="equipment-qty-input" type="number" name="system.quantity" min="0" value="{{system.quantity}}"
                            {{#unless editable}}disabled{{else}}{{#unless itemEditing}}disabled{{/unless}}{{/unless}} />
                    </label>
                </div>
                {{#if consumableFreeUseActive}}
                <p class="spell-free-use-note">{{localize "MDT.spell.freeUseEnabled"}}</p>
                {{/if}}
            </div>
        </div>
    </section>
</form>
